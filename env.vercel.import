# Paste into Vercel: Project Settings > Environment Variables > Bulk Import (Production).
# Replace placeholders before deploying. Do not commit real secrets.

# Neon (or other Postgres) connection string with SSL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Set to your Vercel URL after the first deploy, then redeploy
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app

# Customer origins that may POST submissions (comma-separated). Include your fixture/demo sites if needed.
CORS_ALLOWLIST=https://your-customer-site.example.com

# Demo toggles for geo fallback (usually false in production)
GEO_PROVIDER_A_DOWN=false
GEO_PROVIDER_B_DOWN=false

# Resend (optional). Empty key uses logging stub; submissions still succeed.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
NOTIFY_TO=you@example.com
