# Environment
DATABASE_URL="file:./dev.db"

# Public base URL used in embed snippets (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Toggle geo provider A "down" for fallback demos (true|false)
GEO_PROVIDER_A_DOWN="false"

# Resend API key — leave blank or set a bad key to demo safe side-effect failure
RESEND_API_KEY=""
RESEND_FROM="inspect@widget-platform.local"
NOTIFY_TO="owner@example.com"
