# Copy to `.env` for local development. Do not commit `.env`.

# Local development should use the pooled URL for the `checkpoint` database on
# a schema-only Neon development branch. Never use the production branch here:
# integration tests reset tenant, widget, and submission tables.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/checkpoint?sslmode=require"

# Public base URL of the app (no trailing slash). Used in embed snippets and links.
# Local: http://localhost:3000
# Vercel: set after first deploy to https://your-project.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Extra submission origins allowed by CORS (comma-separated). Defaults include localhost:3000 and :5555.
# Add customer sites that will POST submissions, e.g. https://www.example.com,https://store.example.com
CORS_ALLOWLIST=""

# Set to "true" to simulate geo provider A failing (demo fallback to provider B).
GEO_PROVIDER_A_DOWN="false"

# Set to "true" to simulate geo provider B failing (demo stores { enriched: false } when both fail).
GEO_PROVIDER_B_DOWN="false"

# Resend API key for owner notification emails. Leave empty to log only (no outbound mail).
RESEND_API_KEY=""

# From address for Resend (must be verified in Resend for production sends).
RESEND_FROM="inspect@widget-platform.local"

# Default inbox for submission notify emails when no per-tenant override is set.
NOTIFY_TO="owner@example.com"
